PORT=8000
MONGO_URI=mongodb://localhost:27017/smartspec?replicaSet=rs0
DEV=true
CLIENT_URL=http://localhost:5174

JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_OTP_SECRET=replace-with-a-different-long-random-secret
JWT_EMAIL_SECRET=replace-with-a-different-long-random-secret

GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8000/api/auth/google/oauth

UPLOADS_PATH=./uploads
REDIS_URI=redis://localhost:6488

# Optional email settings for invitation and password reset emails.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@example.com
# EMAIL_PASS=your-email-password

# Python interpreter used by OCR/STT/DOCX/PDF workers (default: python)
PYTHON_PATH=./venv/bin/python
# Số tiến trình Python chạy đồng thời (mặc định: số CPU / 2)
PYTHON_CONCURRENCY=2

# Mức log: debug | info | warn | error | silent (mặc định: debug khi DEV=true, ngược lại info)
LOG_LEVEL=info

# ForgeBridge: tự đồng bộ đặc tả sang WorkHub (BRIDGE_SECRET phải trùng với ForgeBridge)
BRIDGE_URL=http://localhost:8090
BRIDGE_SECRET=change-me-to-a-long-random-string
WORKHUB_ENABLED=true
