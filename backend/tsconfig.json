{
  "compilerOptions": {
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "rootDir": ".",
    "outDir": "./dist",
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "executable/command-ingress/**/*",
    "internal/**/*"
  ]
}